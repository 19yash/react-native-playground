# Environment Configuration Example
# Copy this file to .env.development or .env for local development:
#   cp .env.example .env.development

# APP_ENV: Sets runtime environment. Allowed values: development | preview | production
APP_ENV=development

# EXPO_PUBLIC_* variables are embedded directly into the JavaScript client bundle by Expo at build time.
# WARNING: NEVER put private API secrets, secret tokens, or sensitive credentials in EXPO_PUBLIC_* variables!

# Base API URL for backend services
EXPO_PUBLIC_BASE_URL=https://api.example.com/v1

# Public client identifier or build configuration flag
EXPO_PUBLIC_APP_VARIANT=development
